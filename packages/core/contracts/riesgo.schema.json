{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apih/contracts/riesgo/C1.4",
  "title": "Riesgo (APIH Corporativo C1.4)",
  "description": "Exposición = prob × imp. Crítico si exposición ≥ umbralCritico (parámetro, por defecto 15): exige mit.",
  "type": "object",
  "required": ["ini", "desc", "prob", "imp", "estado"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^RSK-\\d+$", "readOnly": true },
    "version": { "type": "string", "readOnly": true },
    "ini": { "type": "string", "pattern": "^(PROP|PRJ)-\\d+$" },
    "desc": { "type": "string", "minLength": 1 },
    "cat": { "enum": ["Técnico", "Alcance", "Recursos", "Proveedor", "Cronograma", "Financiero", "Regulatorio", "Otro"] },
    "estado": { "enum": ["Abierto", "En mitigación", "Materializado", "Cerrado"] },
    "prob": { "type": "integer", "minimum": 1, "maximum": 5 },
    "imp": { "type": "integer", "minimum": 1, "maximum": 5 },
    "mit": { "type": "string" },
    "dueno": { "type": "string" },
    "fIdent": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "fRev": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
